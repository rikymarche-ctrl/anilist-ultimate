{
  "name": "anilist-ultimate",
  "version": "1.0.3",
  "description": "The ultimate Anilist extension suite - Modern rewrite with TypeScript and Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package": "node scripts/package-release.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui --api.host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "check:coverage": "node scripts/check.mjs --coverage",
    "coverage": "vitest run --coverage",
    "smoke:mv3": "node scripts/smoke-mv3.mjs",
    "smoke:archives": "node scripts/smoke-mv3.mjs --archives",
    "smoke:templates": "node scripts/smoke-mv3.mjs --templates",
    "smoke:calendar": "node scripts/smoke-mv3.mjs --calendar",
    "smoke:scores": "node scripts/smoke-mv3.mjs --scores",
    "smoke:following": "node scripts/smoke-mv3.mjs --following",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\""
  },
  "keywords": [
    "anilist",
    "anime",
    "calendar",
    "chrome-extension"
  ],
  "author": "ExAstra",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.2.5",
    "terser": "^5.46.1",
    "typescript": "^5.4.5",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  }
}
